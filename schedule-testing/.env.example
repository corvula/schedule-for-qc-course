# Copy to .env and fill in values for your environment.
# Defaults match the docker-compose.yaml setup.

BASE_URL=http://localhost:8081
TEST_EMAIL=manager@gmail.com
TEST_PASSWORD=Qwerty!123

# ID of an existing RoomType in the database (created by initial migration)
ROOM_TYPE_ID=1

# IDs used as fixed dependencies for Schedule tests (from initial migration data)
SEMESTER_ID=1
GROUP_ID=1
SCHEDULE_LESSON_ID=1
SCHEDULE_PERIOD_ID=1
SCHEDULE_ROOM_ID=1

# PostgreSQL connection (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
