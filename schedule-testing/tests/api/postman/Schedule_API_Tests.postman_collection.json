              "script": {
                "exec": [
                  "if (!pm.environment.get('scheduleId')) {",
                  "    console.warn('scheduleId is not set, skipping.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of deleted IDs\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 1000ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.environment.unset(\"scheduleId\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer_{{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "{{scheduleId}}"]
            }
          }
        }
      ]
    }
  ]
}
